# lektor-ai – what you change per show and by ear. This is the template.
# Copy it to lektor.toml and edit the copy; that name is gitignored, so a working setup –
# your paths, which engine, whose voice – never turns into a commit. Until the copy exists
# the pipeline falls back to this file, so a fresh checkout still runs.
# Every key here also exists in lektor.tuning.toml, with the measurement behind it. This file
# only overrides, so deleting a line falls back to the tuned default rather than to nothing.
# Secrets never live here. They come from the environment or from the project .env:
# ELEVENLABS_API_KEY, OPENROUTER_API_KEY.

[paths]
# The directory holding the .mkv files. SET THIS ONE on Linux, macOS or Windows without WSL, and
# ignore the two keys under it - a value here overrides both.
input_dir = ''
# Only for the split Windows+WSL setup, where both halves read this file: the same directory as
# input_dir_wsl, spelled the Windows way. Unused when input_dir is set.
input_dir_windows = 'E:\Filmy\Serial.S01'
# The other half of that pair, spelled the Linux way. Nothing checks that the two name the same
# directory.
input_dir_wsl = '/mnt/e/Filmy/Serial.S01'
# Where the working files go, relative to the episode directory: subtitles, the script you edit,
# the finished audio.
work_subdir = '_lektor'
# Where the remuxed .mkv lands, relative to the episode directory.
output_subdir = '_lektor/output'
# Only for the PowerShell half of the split setup. The Python half never uses it - it cannot open
# POSIX paths.
ffmpeg_windows = 'C:\ffmpeg\bin\ffmpeg.exe'
# As above, for ffprobe.
ffprobe_windows = 'C:\ffmpeg\bin\ffprobe.exe'
# The ffmpeg to run. A bare name is enough when it is on PATH, which is what apt, brew and winget
# all give you.
ffmpeg_wsl = 'ffmpeg'
# As above, for ffprobe.
ffprobe_wsl = 'ffprobe'

[extract]
# ISO 639-2 code of the subtitle track to pull out: 'pol' for Polish. Matched on the track's
# language TAG, never on its number.
subtitle_language = 'pol'

[translate]
# What happens to a film with no Polish subtitle track. auto: translate its foreign subtitles
# with an LLM, but only then; always: translate even when there is a Polish track; never: skip it.
mode = 'auto'
# Where the foreign text comes from: 'subs' (a text subtitle track in the film), 'asr' (the
# film's audio, transcribed locally - see [transcribe]) or 'auto', which transcribes only a film
# with no text subtitle at all.
source = 'auto'
# 'auto' takes the audio's own language, then English. A tag such as 'eng' takes only that.
source_language = 'auto'
# The model that translates the whole episode in one call, and the one that gets the lines it
# could not produce. Empty fallback_model disables the hand-over.
openrouter_model = 'openai/gpt-5.6-luna-pro'
fallback_model = 'openai/gpt-5.6-terra'
# The series glossary - names, genders, ty/pan between characters, fixed terms. 'auto' reads
# lektor.glossary.toml beside the episodes when it exists; a path names another; 'off' ignores
# it. `lektor.py glossary` drafts one from an episode for you to correct and save.
glossary = 'auto'
# Polish subtitles from the translation: 'off', 'sidecar' (<film>.pl.srt beside the film) or
# 'mux' (a subtitle stream in the remuxed .mkv). `--subs` overrides it for one run.
subtitles = 'off'

[transcribe]
# Where faster-whisper runs for a film with no text subtitle: 'local' in the venv below, 'docker'
# in a container (speech.asr_container unless `container` names another), 'auto' for local when
# that venv exists and docker otherwise. With neither, the stage stops and says how to install one.
runner = 'auto'
# A venv with faster-whisper installed. Leave empty to use the container.
venv = ''
# The Whisper checkpoint, and 'auto', 'cuda' or 'cpu'. The CPU works and is far slower.
model = 'large-v3'
device = 'auto'

[script]
# The model that shortens lines too long for their slot. Draws twice, then hands over to
# fallback_model.
openrouter_model = 'openai/gpt-5.6-luna'
# Taken up when the model above misses the fit threshold on both draws. Empty string disables
# escalation entirely.
fallback_model = 'openai/gpt-5.6-luna-pro'

[speech]
# Where forced alignment runs: 'local' in aligner_venv, 'docker' in a container, 'auto' for local
# when that venv exists and docker otherwise.
aligner = 'auto'
# A venv with torch and torchaudio, nothing else. Leave empty to use the container instead. With
# neither, the stage keeps the shot cuts and drops the word timings.
aligner_venv = ''
# Align a reference that is not English - a German film's transcript or German subtitle - with
# torchaudio's MMS_FA. Off: its weights are CC-BY-NC 4.0 (non-commercial), and true accepts that.
# Off, such an episode keeps shot cuts only, as before. English always uses the English model.
multilingual_aligner = false

[voice]
# Which engine speaks: elevenlabs, piper, chatterbox, omnivoice or kikivoice. piper is free,
# offline and the default recommendation.
backend = 'piper'

[voice.kikivoice]
# 'clone' speaks with the sample below; 'library' speaks with a catalogue voice named by
# voice_code and voice_id.
mode = 'clone'
# Catalogue voice. Read only when mode = 'library'.
voice_code = 'S089'
# The same catalogue voice's id. Read only when mode = 'library'.
voice_id = 'standard_30002'
# Which kikivoice model speaks. kiki_core covers Polish; this also decides the credit rate per
# character.
model_type = 'kiki_core'

[voice.kikivoice.clone]
# The recording the voice is cloned from, uploaded to the server once a day. 5 to 120 s, any
# format ffmpeg reads. Changing it invalidates every cached line of that voice.
#
# Keep it OUTSIDE the repository. It is a recording of a voice - your own, which is the case this
# was built around - and .gitignore refuses audio outright so a sample cannot reach the history by
# accident.
sample_path = '~/voice-samples/my-voice.m4a'

[voice.elevenlabs]
# The ElevenLabs voice, copied from the voice's page in your own account - a voice id is account
# scoped, so somebody else's is of no use to you and none ships here. Changing it calls for a
# re-calibration and a re-measured presence shelf, see the same key in the tuning file.
voice_id = ''
# Which ElevenLabs model reads. flash and turbo cost half of the rest and get twice the
# concurrency.
model_id = 'eleven_flash_v2_5'

[voice.piper]
# Piper voice, downloaded into the cache on first use. pl_PL-darkman-medium is the flat male one
# this project reads as a lektor.
voice = 'pl_PL-darkman-medium'

[voice.omnivoice]
# A venv with torch and omnivoice. The model is held by a worker launched from it, so the pipeline
# itself never imports torch.
venv = '~/.cache/lektor-ai-omnivoice/venv-omnivoice'
# A 3 to 10 s recording of the voice it should speak in - your own, recorded for the purpose, is
# the case this was built around. Shorter is both faster and a better clone - 5.2 s measured 1.5x
# faster than 7.8 s. Mono 24 kHz is what the model reads; anything ffmpeg opens will be converted,
# but cutting it yourself is how you control WHICH five seconds it hears.
#
# Record it DRY, and cut it from CONTINUOUS speech. A clip taken from a finished mix carries
# whatever sat under the speaker - music, effects, another language - and the model reproduces that
# in every line it then speaks. Measured while searching a 28-minute mixed recording for a usable
# five seconds: the cleanest window in the whole file still had the backing only 32 dB below the
# speaker, and it was audible in the result. No amount of searching closes that gap; recording dry
# does.
#
# Keep it OUTSIDE the repository: see the note on kikivoice's sample_path above.
reference_wav = '~/.cache/lektor-ai-omnivoice/reference.wav'
# Language code OmniVoice reads the text as. 'pl' for Polish.
language = 'pl'

[voice.chatterbox]
# A venv with torch and chatterbox, spoken to the same way as omnivoice's.
venv = '~/.cache/lektor-ai-chatterbox/venv-chatterbox'
# Language code Chatterbox reads the text as.
language_id = 'pl'
# An 8 to 20 s recording to clone from. Empty means the model's own built-in voice, which is the
# only setting here that involves nobody's voice but the model's. The same sourcing rules as
# omnivoice apply to anything you put here.
reference_wav = ''

[mix]
# '5.1(side)' puts the lektor on the centre channel and leaves the film's surround alone. 'stereo'
# folds it into both speakers.
channel_layout = '5.1(side)'
# A final nudge to the lektor's level in dB, applied after everything else. This is the taste
# knob.
voice_trim_db = 1.5
# How far above the film's OWN DIALOGUE the lektor sits, in LU. The main loudness setting; 6 to 7
# is the useful range.
voice_over_dialogue_lu = 6.0

[clean]
# Which evidence may refuse joining two cards into one breath: 'pause', 'cut', 'both', or 'off' to
# join on the text rules alone.
merge_gate = 'both'
