# Secrets live here or in the environment, NEVER in lektor.toml. An already-exported variable
# always wins, so `set -a && . .env` in the shell and the pipeline's own loader cannot disagree.
# Copy to .env - that name is in .gitignore, this template is not.

# Shortens the lines too long for their slot. Without it nothing is condensed and the lektor does
# not fit his windows. Roughly $0.02 per episode. The translate stage uses the same key for films
# with no Polish subtitle track; without it those films stop there. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Only for the elevenlabs backend; every other engine runs locally and needs nothing here.
# Without it that one backend refuses to start and the rest are unaffected.
ELEVENLABS_API_KEY=
